# Projeto Supabase (somente no PC do bot; nunca envie a chave secreta ao navegador/GitHub)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_PRIVADA

# UUID de um admin/operator ativo do painel; usado apenas para auditoria dos comandos do bot
BOT_ADMIN_USER_ID=UUID_DO_ADMIN

# Identificador livre desta instância do bot
BOT_WORKER_ID=pc-leilao-01

# Pasta local da sessão Baileys. NÃO versionar nem compartilhar.
WHATSAPP_SESSION_DIR=./sessao
