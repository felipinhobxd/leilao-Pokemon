NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: Vercel's Supabase integration provides SUPABASE_SECRET_KEY.
# Legacy SUPABASE_SERVICE_ROLE_KEY remains supported for local/self-hosted setups.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional (Fase 4.2 — rate limit do /api/cards/image/authorize):
# com REDIS_URL o limite de 50/min por usuário é distribuído entre instâncias
# (deploy serverless); sem ela vale o fallback in-memory por instância.
#REDIS_URL=redis://127.0.0.1:6379

# Opcional (Fase 4.3 — sem lotes "fantasmas"):
# RECOGNITION_BASE_URL aponta para o serviço de reconhecimento local
# (default http://127.0.0.1:8765). RECOGNITION_STRICT_CATALOG=1 bloqueia a
# criação de lotes quando o catálogo não pôde ser consultado (site+serviço
# na mesma máquina); sem a variável, lotes sem validação são criados com log.
#RECOGNITION_BASE_URL=http://127.0.0.1:8765
#RECOGNITION_STRICT_CATALOG=0


# Serviço local de reconhecimento (mesmo segredo no servidor Next.js e no PC)
# Deve ter pelo menos 32 caracteres. Nunca use NEXT_PUBLIC_ para esta variável.
RECOGNITION_SERVICE_SHARED_SECRET=
