# Projeto Supabase (somente no PC do bot; nunca envie a chave secreta ao navegador/GitHub)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_PRIVADA

# UUID de um admin/operator ativo do painel; usado apenas para auditoria dos comandos do leilão
BOT_ADMIN_USER_ID=UUID_DO_ADMIN

# Identificador estável desta instalação do bot
BOT_WORKER_ID=pc-leilao-01

# Pasta local da sessão Baileys. NÃO versionar nem compartilhar.
WHATSAPP_SESSION_DIR=./sessao

# O supervisor mantém heartbeat entre 10 e 15 segundos.
BOT_HEARTBEAT_SECONDS=12

# QR temporário publicado no painel (45 a 180 segundos).
BOT_QR_TTL_SECONDS=90

# Opcional: logs internos do Baileys. O padrão silencioso evita ruído.
BOT_LOG_LEVEL=silent
